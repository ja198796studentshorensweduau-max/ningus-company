<!DOCTYPE html>
<html>
<head>
<meta http-equiv="x-ua-compatible" content="ie=edge">
<meta charset="utf-8">
<title>Ningus Company</title>
<hta:application id="ningus" applicationname="Ningus Company" border="dialog" borderstyle="normal"
  caption="yes" sysmenu="yes" minimizebutton="yes" maximizebutton="no" scroll="no"
  singleinstance="yes" showintaskbar="yes" contextmenu="no" selection="no" />
<style>
  html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }
  body {
    font-family: "Segoe UI", Tahoma, sans-serif; color: #e8eaf6; cursor: default;
    background: #12162b; background: linear-gradient(160deg, #1a2040 0%, #0d1020 100%);
  }
  .wrap { padding: 28px 32px; }
  .brand { height: 48px; }
  .logo {
    float: left; width: 44px; height: 44px; line-height: 44px; text-align: center;
    border-radius: 12px; font-size: 24px; font-weight: bold; color: #fff;
    background: #5b6cff; background: linear-gradient(135deg, #7a5cff, #3fa9ff);
  }
  .name { margin-left: 58px; font-size: 22px; font-weight: 600; line-height: 26px; }
  .sub  { margin-left: 58px; font-size: 12px; color: #8b93c4; line-height: 18px; }
  #status { margin-top: 34px; font-size: 14px; height: 20px; }
  .track { margin-top: 12px; height: 10px; border-radius: 5px; background: #262c52; overflow: hidden; position: relative; }
  #fill  { height: 100%; width: 0; border-radius: 5px; background: #5b8bff; background: linear-gradient(90deg, #7a5cff, #3fa9ff); }
  .indet #fill { position: absolute; width: 35%; animation: slide 1.1s ease-in-out infinite; }
  @keyframes slide { 0% { left: -35%; } 100% { left: 100%; } }
  #detail { margin-top: 8px; font-size: 12px; color: #8b93c4; height: 16px; }
  #err { display: none; margin-top: 14px; font-size: 12px; color: #ff9a9a; }
  #btns { display: none; margin-top: 14px; }
  button {
    font-family: inherit; font-size: 13px; color: #fff; border: 0; border-radius: 6px;
    padding: 7px 18px; margin-right: 8px; cursor: pointer; background: #5b6cff;
  }
  button.alt { background: #2c3359; }
  .error #fill { background: #ff6b6b; }
</style>
</head>
<body>
<div class="wrap" id="wrap">
  <div class="brand">
    <div class="logo">N</div>
    <div class="name">Ningus Company</div>
    <div class="sub" id="ver">Launcher</div>
  </div>
  <div id="status">Starting...</div>
  <div class="track" id="track"><div id="fill"></div></div>
  <div id="detail">&nbsp;</div>
  <div id="err"></div>
  <div id="btns">
    <button id="retry" onclick="start()">Retry</button>
    <button id="existing" class="alt" onclick="launch()">Launch installed version</button>
  </div>
</div>

<!-- Worker script: downloads, extracts and swaps in the new version, reporting progress to a status file -->
<script type="text/plain" id="ps">
param($Url, $Root, $AppDir, $Status)
$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
function S($p, $m) { try { [IO.File]::WriteAllText($Status, "$p|$m") } catch {} }
[void][IO.Directory]::CreateDirectory($Root)
$tmp = Join-Path $Root ('.tmp_' + [guid]::NewGuid().ToString('N'))
try {
  [void][IO.Directory]::CreateDirectory($tmp)
  $zip = Join-Path $tmp 'update.zip'
  S 0 'Connecting...'
  $req = [Net.HttpWebRequest]::Create($Url)
  $req.UserAgent = 'NingusLauncher'
  $res = $req.GetResponse()
  $len = $res.ContentLength
  $in = $res.GetResponseStream()
  $out = [IO.File]::Create($zip)
  $buf = New-Object byte[] 65536
  $tot = 0
  $sw = [Diagnostics.Stopwatch]::StartNew()
  while (($n = $in.Read($buf, 0, $buf.Length)) -gt 0) {
    $out.Write($buf, 0, $n)
    $tot += $n
    if ($sw.ElapsedMilliseconds -gt 120) {
      $sw.Restart()
      $mb = [math]::Round($tot / 1MB, 1)
      if ($len -gt 0) {
        $tl = [math]::Round($len / 1MB, 1)
        S ([int](80 * $tot / $len)) "Downloading... $mb MB of $tl MB"
      } else { S -1 "Downloading... $mb MB" }
    }
  }
  $out.Close(); $in.Close(); $res.Close()
  $hdr = New-Object byte[] 2
  $fs = [IO.File]::OpenRead($zip); [void]$fs.Read($hdr, 0, 2); $fs.Close()
  $ext = Join-Path $tmp 'extracted'
  if ($hdr[0] -eq 0x50 -and $hdr[1] -eq 0x4B) {
    S 82 'Unpacking...'
    Expand-Archive -LiteralPath $zip -DestinationPath $ext -Force
  } else {
    # Not a zip: a single file (.html, .exe, .hta). Keep the name from the URL.
    [void][IO.Directory]::CreateDirectory($ext)
    $name = [IO.Path]::GetFileName([Uri]::UnescapeDataString(([Uri]$Url).LocalPath))
    if (-not $name) { $name = 'app.html' }
    [IO.File]::Copy($zip, (Join-Path $ext $name))
  }
  S 94 'Installing...'
  $items = @(Get-ChildItem -LiteralPath $ext)
  $src = $ext
  if ($items.Count -eq 1 -and $items[0].PSIsContainer) { $src = $items[0].FullName }
  if ([IO.Directory]::Exists($AppDir)) { [IO.Directory]::Delete($AppDir, $true) }
  [IO.Directory]::Move($src, $AppDir)
  S 100 'Done'
  [IO.File]::WriteAllText($Status, 'DONE|')
} catch {
  [IO.File]::WriteAllText($Status, 'ERR|' + $_.Exception.Message + ' (line ' + $_.InvocationInfo.ScriptLineNumber + ')')
} finally {
  Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue
}
</script>

<script language="JScript">
// ------------- Config -------------
var VERSION_URL = 'https://github.com/ja198796studentshorensweduau-max/ningus-company/blob/main/version.json';
// ----------------------------------

var fso = new ActiveXObject('Scripting.FileSystemObject');
var sh  = new ActiveXObject('WScript.Shell');
var ROOT   = sh.ExpandEnvironmentStrings('%APPDATA%') + '\\NingusCompany';
var APP    = ROOT + '\\app';
var LOCAL  = ROOT + '\\local-version.json';
var TEMP   = sh.ExpandEnvironmentStrings('%TEMP%');
var STATUS = TEMP + '\\ningus_status.txt';
var WORKER = TEMP + '\\ningus_worker.ps1';

var remote = null, local = null, poller = null;

function $(id) { return document.getElementById(id); }

function ui(msg, pct, detail) {
  $('status').innerText = msg;
  $('detail').innerText = detail || '\u00a0';
  var track = $('track');
  if (pct < 0) { track.className = 'track indet'; }
  else { track.className = 'track'; $('fill').style.width = pct + '%'; }
}

function fail(msg) {
  document.body.className = 'error';
  $('status').innerText = 'Something went wrong';
  $('track').className = 'track';
  $('fill').style.width = '100%';
  $('err').style.display = 'block';
  $('err').innerText = msg;
  $('btns').style.display = 'block';
  $('existing').style.display = isInstalled() ? 'inline' : 'none';
}

function ensureFolder(p) {
  if (fso.FolderExists(p)) return;
  var parent = fso.GetParentFolderName(p);
  if (parent && !fso.FolderExists(parent)) ensureFolder(parent);
  fso.CreateFolder(p);
}

function readFile(p) { var f = fso.OpenTextFile(p, 1); var t = f.ReadAll(); f.Close(); return t; }
function writeFile(p, t) { var f = fso.CreateTextFile(p, true, false); f.Write(t); f.Close(); }

function readLocal() {
  local = null;
  try { if (fso.FileExists(LOCAL)) local = JSON.parse(readFile(LOCAL)); } catch (e) { local = null; }
}
function isInstalled() { return !!(local && local.version && fso.FolderExists(APP)); }

// github.com/user/repo/blob/branch/path  ->  raw.githubusercontent.com/user/repo/branch/path
function toRaw(u) {
  return String(u).replace(/^https:\/\/github\.com\/([^\/]+)\/([^\/]+)\/blob\/(.+)$/, 'https://raw.githubusercontent.com/$1/$2/$3');
}

function cmpVer(a, b) {
  var pa = String(a).replace(/^[vV]/, '').split('.'), pb = String(b).replace(/^[vV]/, '').split('.');
  var n = Math.max(pa.length, pb.length);
  for (var i = 0; i < n; i++) {
    var x = parseInt(pa[i] || '0', 10), y = parseInt(pb[i] || '0', 10);
    if (isNaN(x) || isNaN(y)) return String(a) === String(b) ? 0 : 1;
    if (x > y) return 1;
    if (x < y) return -1;
  }
  return 0;
}

function fetchText(url, cb) {
  var done = false;
  var x = new ActiveXObject('MSXML2.XMLHTTP.6.0');
  var timer = setTimeout(function () {
    if (done) return; done = true;
    try { x.abort(); } catch (e) {}
    cb('Timed out');
  }, 15000);
  x.open('GET', url, true);
  x.onreadystatechange = function () {
    if (x.readyState !== 4 || done) return;
    done = true; clearTimeout(timer);
    if (x.status === 200) cb(null, x.responseText);
    else cb(x.status ? 'HTTP ' + x.status : 'No connection');
  };
  try { x.send(); } catch (e) { if (!done) { done = true; clearTimeout(timer); cb('No connection'); } }
}

function start() {
  document.body.className = '';
  $('err').style.display = 'none';
  $('btns').style.display = 'none';
  ui('Checking for updates...', -1);
  readLocal();
  if (local && local.version) $('ver').innerText = 'Installed version ' + local.version;

  fetchText(toRaw(VERSION_URL) + '?t=' + new Date().getTime(), function (err, text) {
    if (!err) {
      try {
        remote = JSON.parse(String(text).replace(/^\uFEFF/, '').replace(/,(\s*[}\]])/g, '$1'));
        if (!remote.version || !remote.download) err = 'version.json must contain "version" and "download".';
      } catch (e) { err = 'version.json is empty or not valid JSON.'; }
    }
    if (err) {
      if (isInstalled()) {
        ui('Could not check for updates (' + err + ')', 100, 'Launching installed version...');
        setTimeout(launch, 1200);
      } else {
        fail('Could not get version info: ' + err);
      }
      return;
    }
    var needs = !isInstalled() || cmpVer(remote.version, local.version) > 0;
    if (needs) install(); else { ui('Up to date', 100, 'Version ' + local.version); setTimeout(launch, 600); }
  });
}

function install() {
  $('ver').innerText = 'Installing version ' + remote.version;
  ui('Starting download...', -1);
  try {
    ensureFolder(ROOT);
    if (fso.FileExists(STATUS)) fso.DeleteFile(STATUS, true);
    writeFile(WORKER, $('ps').text);
    var cmd = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "' + WORKER + '"' +
      ' -Url "' + toRaw(remote.download) + '" -Root "' + ROOT + '" -AppDir "' + APP + '" -Status "' + STATUS + '"';
    sh.Run(cmd, 0, false);
  } catch (e) { return installFailed('Could not start installer: ' + e.message); }

  var began = new Date().getTime();
  poller = setInterval(function () {
    var s = '';
    try { if (fso.FileExists(STATUS)) s = readFile(STATUS); } catch (e) { return; }
    if (!s) {
      if (new Date().getTime() - began > 30000) { clearInterval(poller); installFailed('Installer did not start.'); }
      return;
    }
    var i = s.indexOf('|'), head = s.substring(0, i), body = s.substring(i + 1);
    if (head === 'DONE') {
      clearInterval(poller);
      try { writeFile(LOCAL, JSON.stringify({ version: String(remote.version), entry: remote.entry || remote.exe || '' })); }
      catch (e) { return fail('Installed, but could not save version info: ' + e.message); }
      readLocal();
      ui('Installed', 100, 'Version ' + remote.version);
      setTimeout(launch, 600);
    } else if (head === 'ERR') {
      clearInterval(poller);
      installFailed(body);
    } else {
      var p = parseInt(head, 10);
      ui(p >= 0 && p < 82 ? 'Downloading update...' : (body || 'Working...'), isNaN(p) ? -1 : p, body);
    }
  }, 150);
}

function installFailed(msg) {
  if (isInstalled()) {
    ui('Update failed', 100, 'Launching installed version...');
    $('err').style.display = 'block'; $('err').innerText = msg;
    setTimeout(launch, 2500);
  } else {
    fail(msg);
  }
}

// Find the thing to run: named entry first, otherwise first .exe, then .hta, then .html
function findEntry() {
  if (local && local.entry) {
    var p = APP + '\\' + String(local.entry).replace(/\//g, '\\');
    if (fso.FileExists(p)) return p;
  }
  var best = null, rank = 99;
  function walk(folder) {
    var fe = new Enumerator(folder.Files);
    for (; !fe.atEnd(); fe.moveNext()) {
      var f = fe.item(), ext = fso.GetExtensionName(f.Path).toLowerCase(), r = 99;
      if (ext === 'exe') r = 0; else if (ext === 'hta') r = 1;
      else if (ext === 'html' || ext === 'htm') r = (f.Name.toLowerCase().indexOf('index.') === 0) ? 2 : 3;
      if (r < rank) { rank = r; best = f.Path; }
    }
    var se = new Enumerator(folder.SubFolders);
    for (; !se.atEnd(); se.moveNext()) walk(se.item());
  }
  walk(fso.GetFolder(APP));
  return best;
}

function launch() {
  readLocal();
  try {
    if (!isInstalled()) throw new Error('Nothing is installed yet.');
    var entry = findEntry();
    if (!entry) throw new Error('No launchable file (.exe, .hta, .html) found in ' + APP);
    ui('Launching...', 100, fso.GetFileName(entry));
    sh.CurrentDirectory = fso.GetParentFolderName(entry);
    sh.Run('"' + entry + '"', 1, false);
    setTimeout(function () { window.close(); }, 1200);
  } catch (e) { fail(e.message); }
}

window.onload = function () {
  window.resizeTo(500, 360);
  window.moveTo(Math.round((screen.availWidth - 500) / 2), Math.round((screen.availHeight - 360) / 2));
  start();
};
</script>
</body>
</html>
